{
  "name": "ldoe-scout",
  "version": "1.0.0",
  "description": "Interactive map project for Last Day on Earth: Survival. This tool is designed for seamless navigation through game locations, tracking resources, bosses, and other key points of interest.",
  "main": "main.js",
  "scripts": {
    "dev:js": "esbuild _scripts/main.ts --bundle --outfile=assets/js/main.js --sourcemap --watch",
    "dev:jekyll": "bundle exec jekyll serve --watch --incremental",
    "dev": "concurrently \"npm run dev:js\" \"npm run dev:jekyll\"",
    "build:js": "esbuild _scripts/main.ts --bundle --outfile=assets/js/main.js --minify",
    "build:jekyll": "bundle exec jekyll build",
    "build": "npm run build:js && npm run build:jekyll",
    "deploy": "sh deploy.sh",
    "clean": "bundle exec jekyll clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovgamesdev/ldoe-scout.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ovgamesdev/ldoe-scout/issues"
  },
  "homepage": "https://github.com/ovgamesdev/ldoe-scout#readme",
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
